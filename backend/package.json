{
  "name": "tour-backend",
  "version": "1.0.0",
  "description": "Travel Packages Platform - Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "migrate": "typeorm-ts-node-esm migration:run -d src/config/connection.ts",
    "migrate:generate": "typeorm-ts-node-esm migration:generate -d src/config/connection.ts",
    "migrate:revert": "typeorm-ts-node-esm migration:revert -d src/config/connection.ts",
    "seed": "tsx src/database/seed.ts",
    "populate-categories": "tsx src/database/fixes/populate-categories.ts",
    "fix:categories": "tsx src/database/fixes/populate-categories.ts",
    "fill-translations": "tsx src/scripts/fillTranslations.ts"
  },
  "keywords": [
    "tour",
    "travel",
    "booking",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "aws-sdk": "^2.1545.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "esbuild": "^0.28.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "pg-pool": "^3.10.1",
    "redis": "^4.7.1",
    "resend": "^6.5.2",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.27",
    "typescript": "^5.3.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.12.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.7.0"
  }
}
