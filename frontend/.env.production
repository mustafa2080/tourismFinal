# Tour Application - PRODUCTION Configuration
# This file is used automatically by Vite when running `npm run build`
# (mode=production). Do NOT put localhost values here.

# API Configuration
VITE_API_URL=https://travluyo.com/api
VITE_SOCKET_URL=https://travluyo.com
# SEO Configuration
VITE_DOMAIN=travluyo.com
VITE_SITE_NAME=Travluyo
